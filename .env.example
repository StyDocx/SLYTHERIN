# ==============================================================================
# ENVIRONMENT VARIABLES FOR LOCAL DEV & PRODUCTION (VERCEL / SUPABASE)
# ==============================================================================
# In Vercel: Project Settings → Environment Variables (add these for Production)
# Locally: Copy to .env (do NOT commit .env with real secrets to GitHub)

NODE_ENV=production
PORT=3000

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION (from Supabase Dashboard → Project Settings → API)
# ------------------------------------------------------------------------------
# Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Project API Anon Key (public client key)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Project API Service Role Key (SECRET: server-only, never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# SERVER & SECURITY SETTINGS
# ------------------------------------------------------------------------------
# Set to 1 when behind Vercel / Cloudflare / reverse proxy (for real IP rate-limiting)
TRUST_PROXY=1

# Optional: Extra allowed origins for CORS / CSRF (comma-separated, e.g. https://yourcustomdomain.com)
ALLOWED_ORIGINS=

# Optional: Google Apps Script Webhook URL for Google Sheets sync
GOOGLE_SHEET_WEBHOOK_URL=
